(version 1)
(rule "Minimum clearance 1"
	(constraint clearance (min 0.1mm))
)
(rule "Courtyard clearance 1"
	(constraint courtyard_clearance (min 0.2mm))
)
(rule "Minimum annular width 1"
	(constraint annular_width (min 0.15mm))
)
(rule "Minimum text height and thickness 1"
	(layer "F.Silkscreen")
	(constraint text_height (min 0.8mm))
	(constraint text_thickness (min 0.15mm))
)
(rule "Minimum text height and thickness 2"
	(layer "B.Silkscreen")
	(constraint text_height (min 0.8mm))
	(constraint text_thickness (min 0.15mm))
)
